<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_quant_tree_inventory_editable_pda" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.pda</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="pda_count_origin" optional="show" />
                <field name="pda_count_start" optional="hide" />
                <field name="pda_count_end" optional="hide" />
                <field name="pda_count_comment" optional="show" />
            </field>
        </field>
    </record>

    <record id="quant_search_view_pda" model="ir.ui.view">
        <field name="name">stock.quant.search.pda</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view" />
        <field name="arch" type="xml">
            <filter name="to_apply" position="after">
                <filter
                    name="from_pda"
                    string="Desde PDA"
                    domain="[('pda_count_origin', '!=', False)]"
                />
            </filter>
        </field>
    </record>

    <record id="view_move_line_tree_pda" model="ir.ui.view">
        <field name="name">stock.move.line.list.pda</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="pda_count_start" optional="hide" />
                <field name="pda_count_end" optional="hide" />
                <field name="pda_count_comment" optional="show" />
            </field>
        </field>
    </record>
</odoo>
