<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_pda_inventory_log_list" model="ir.ui.view">
        <field name="name">matriz.almonte.pda.inventory.log.list</field>
        <field name="model">matriz.almonte.pda.inventory.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="1">
                <field name="create_date" />
                <field name="name" />
                <field name="warehouse_id" optional="show" />
                <field name="location_id" optional="hide" />
                <field name="product_id" />
                <field name="id_articulo" optional="hide" />
                <field name="quantity" sum="Total" />
                <field name="counted_after" optional="show" />
                <field name="product_uom_id" optional="hide" />
                <field name="token_id" optional="show" />
                <field name="user_id" optional="hide" />
                <field name="pda_count_start" optional="hide" />
                <field name="pda_count_end" optional="show" />
                <field name="pda_count_comment" optional="show" />
                <field name="pda_uuid" optional="hide" />
                <field name="company_id" optional="hide" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_pda_inventory_log_form" model="ir.ui.view">
        <field name="name">matriz.almonte.pda.inventory.log.form</field>
        <field name="model">matriz.almonte.pda.inventory.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="create_date" />
                            <field name="warehouse_id" />
                            <field name="location_id" />
                            <field name="product_id" />
                            <field name="id_articulo" />
                            <field name="quantity" />
                            <field name="counted_after" />
                        </group>
                        <group>
                            <field name="token_id" />
                            <field name="user_id" />
                            <field name="pda_uuid" />
                            <field name="pda_count_start" />
                            <field name="pda_count_end" />
                            <field name="quant_id" />
                        </group>
                    </group>
                    <field name="pda_count_comment" placeholder="Sin comentario" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pda_inventory_log_search" model="ir.ui.view">
        <field name="name">matriz.almonte.pda.inventory.log.search</field>
        <field name="model">matriz.almonte.pda.inventory.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="product_id" />
                <field name="id_articulo" />
                <field name="warehouse_id" />
                <field name="token_id" />
                <field name="pda_uuid" />
                <filter name="today" string="Hoy"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]" />
                <group>
                    <filter name="group_name" string="Inventario" context="{'group_by': 'name'}" />
                    <filter name="group_product" string="Artículo" context="{'group_by': 'product_id'}" />
                    <filter name="group_warehouse" string="Almacén" context="{'group_by': 'warehouse_id'}" />
                    <filter name="group_token" string="PDA" context="{'group_by': 'token_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_pda_inventory_log" model="ir.actions.act_window">
        <field name="name">Envíos de inventario PDA</field>
        <field name="res_model">matriz.almonte.pda.inventory.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pda_inventory_log_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no ha llegado ningún inventario desde la PDA.</p>
            <p>Cada línea que envía una PDA queda registrada aquí: una fila por artículo y envío.</p>
        </field>
    </record>

    <menuitem
        id="menu_pda_inventory_log"
        name="Envíos de inventario PDA"
        parent="stock.menu_stock_adjustments"
        action="action_pda_inventory_log"
        sequence="11"
    />
</odoo>
