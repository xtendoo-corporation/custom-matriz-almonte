<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Se lanza sola al aplicar la última línea de un inventario de la
             PDA; la ejecución periódica es solo una red de seguridad. -->
        <record id="ir_cron_pda_inventory_zeroing" model="ir.cron">
            <field name="name">PDA: poner a 0 lo no inventariado</field>
            <field name="model_id" ref="model_matriz_almonte_pda_inventory_zeroing" />
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True" />
        </record>
    </data>
</odoo>
