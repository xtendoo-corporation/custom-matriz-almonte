<odoo>

    <!-- Ajustes > Punto de Venta: impresora térmica directa para tickets PDA -->
    <record id="res_config_settings_view_form_pda_printer" model="ir.ui.view">
        <field name="name">res.config.settings.form.pda.printer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_connected_devices_section']" position="inside">
                <setting id="pos_pda_ticket_printer"
                         string="Impresora ticket PDA (80mm térmica)"
                         help="Impresión directa por red (ESC/POS sobre TCP) del ticket de los pedidos importados desde la PDA. Deja la IP vacía para usar el bridge local.">
                    <div class="content-group">
                        <div class="row mt-2">
                            <label string="IP de la impresora"
                                   for="pos_pda_ticket_printer_host"
                                   class="col-lg-4 o_light_label" />
                            <field name="pos_pda_ticket_printer_host"
                                   placeholder="Ej: 192.168.1.100" />
                        </div>
                        <div class="row mt-2">
                            <label string="Puerto TCP"
                                   for="pos_pda_ticket_printer_port"
                                   class="col-lg-4 o_light_label" />
                            <field name="pos_pda_ticket_printer_port"
                                   placeholder="9100" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>

