<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA DE LISTA (List) -->
    <record id="view_matriz_almonte_tienda_tree" model="ir.ui.view">
        <field name="name">matriz.almonte.tienda.list</field>
        <field name="model">matriz.almonte.tienda</field>
        <field name="arch" type="xml">
            <list string="Tiendas">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- VISTA DE FORMULARIO (Form) -->
    <record id="view_matriz_almonte_tienda_form" model="ir.ui.view">
        <field name="name">matriz.almonte.tienda.form</field>
        <field name="model">matriz.almonte.tienda</field>
        <field name="arch" type="xml">
            <form string="Tienda">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Nombre de la Tienda"/>
                        <h1>
                            <field name="name" placeholder="Ej. Tienda Centro..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACCIÓN (Lo que ejecuta el menú) -->
    <record id="action_matriz_almonte_tienda" model="ir.actions.act_window">
        <field name="name">Tiendas</field>
        <field name="res_model">matriz.almonte.tienda</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera Tienda
            </p>
            <p>
                Aquí podrás gestionar todas las tiendas para luego asignarlas a las PDAs.
            </p>
        </field>
    </record>
</odoo>