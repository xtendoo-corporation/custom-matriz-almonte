<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Cliente genérico usado como último recurso para emitir la factura
        simplificada de una venta importada desde la PDA cuando el pedido no
        trae cliente y el TPV no define un "Cliente por Defecto".
    -->
    <record id="partner_consumidor_final" model="res.partner">
        <field name="name">Consumidor Final</field>
        <field name="company_type">person</field>
        <field name="customer_rank">1</field>
    </record>

</odoo>
