<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_store_demand" model="ir.module.category">
        <field name="name">Pre-pedidos de tienda</field>
        <field name="sequence">40</field>
    </record>

    <record id="res_groups_privilege_store_demand" model="res.groups.privilege">
        <field name="name">Pre-pedidos de tienda</field>
        <field name="category_id" ref="module_category_store_demand"/>
    </record>

    <record id="group_store_demand_user" model="res.groups">
        <field name="name">Tienda</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_store_demand"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Crea y envía los pre-pedidos de su tienda (almacén por defecto del usuario).</field>
    </record>

    <record id="group_store_demand_manager" model="res.groups">
        <field name="name">Central</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_store_demand"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_store_demand_user')),
            Command.link(ref('purchase.group_purchase_user')),
            Command.link(ref('stock.group_stock_user')),
        ]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Ve los pre-pedidos de todas las tiendas, los consolida en compras y reparte.</field>
    </record>

    <record id="rule_store_demand_company" model="ir.rule">
        <field name="name">Pre-pedidos: multicompañía</field>
        <field name="model_id" ref="model_matriz_store_demand"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_store_demand_line_company" model="ir.rule">
        <field name="name">Líneas de pre-pedido: multicompañía</field>
        <field name="model_id" ref="model_matriz_store_demand_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_store_demand_user_own_shop" model="ir.rule">
        <field name="name">Pre-pedidos: solo su tienda</field>
        <field name="model_id" ref="model_matriz_store_demand"/>
        <field name="domain_force">[('warehouse_id', '=', user.property_warehouse_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_store_demand_user'))]"/>
    </record>

    <record id="rule_store_demand_line_user_own_shop" model="ir.rule">
        <field name="name">Líneas de pre-pedido: solo su tienda</field>
        <field name="model_id" ref="model_matriz_store_demand_line"/>
        <field name="domain_force">[('warehouse_id', '=', user.property_warehouse_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_store_demand_user'))]"/>
    </record>

    <record id="rule_store_demand_manager_all" model="ir.rule">
        <field name="name">Pre-pedidos: central ve todas las tiendas</field>
        <field name="model_id" ref="model_matriz_store_demand"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_store_demand_manager'))]"/>
    </record>

    <record id="rule_store_demand_line_manager_all" model="ir.rule">
        <field name="name">Líneas de pre-pedido: central ve todas las tiendas</field>
        <field name="model_id" ref="model_matriz_store_demand_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_store_demand_manager'))]"/>
    </record>
</odoo>
