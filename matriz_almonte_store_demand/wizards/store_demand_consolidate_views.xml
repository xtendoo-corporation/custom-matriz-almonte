<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_store_demand_consolidate_form" model="ir.ui.view">
        <field name="name">matriz.store.demand.consolidate.form</field>
        <field name="model">matriz.store.demand.consolidate</field>
        <field name="arch" type="xml">
            <form string="Consolidar demanda">
                <group>
                    <group>
                        <field name="central_warehouse_id"/>
                        <field name="use_central_stock"/>
                    </group>
                    <group>
                        <field name="demand_count"/>
                        <field name="purchase_partner_count"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="partner_id" options="{'no_create': True}"
                               required="purchase_qty > 0"/>
                        <field name="product_id"/>
                        <field name="shop_names"/>
                        <field name="demand_qty" sum="Total"/>
                        <field name="central_free_qty"/>
                        <field name="purchase_qty" sum="Total"/>
                        <field name="product_uom_id" groups="uom.group_uom"/>
                    </list>
                </field>
                <p class="text-muted">
                    Se crea un pedido de compra por proveedor con entrega en el almacén
                    central y un traspaso por tienda desde central con toda la cantidad
                    solicitada. Los traspasos se reservan solos al recibir la compra.
                </p>
                <footer>
                    <button name="action_consolidate" type="object" string="Consolidar"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_server_store_demand_consolidate" model="ir.actions.server">
        <field name="name">Consolidar demanda</field>
        <field name="model_id" ref="model_matriz_store_demand_consolidate"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_all()</field>
        <field name="group_ids" eval="[Command.link(ref('group_store_demand_manager'))]"/>
    </record>
</odoo>
