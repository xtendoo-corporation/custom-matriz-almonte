<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_form_store_demand" model="ir.ui.view">
        <field name="name">stock.warehouse.form.store.demand</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="is_store_demand_central"/>
            </field>
        </field>
    </record>

    <record id="view_warehouse_list_store_demand" model="ir.ui.view">
        <field name="name">stock.warehouse.list.store.demand</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="is_store_demand_central" optional="show"/>
            </field>
        </field>
    </record>

    <record id="action_store_demand_warehouse" model="ir.actions.act_window">
        <field name="name">Almacenes y tiendas</field>
        <field name="res_model">stock.warehouse</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
