<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_store_demand_line_list" model="ir.ui.view">
        <field name="name">matriz.store.demand.line.list</field>
        <field name="model">matriz.store.demand.line</field>
        <field name="arch" type="xml">
            <list string="Demanda de tiendas" create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_consolidate" type="object"
                            string="Consolidar selección" class="btn-primary"/>
                </header>
                <field name="demand_id"/>
                <field name="date_request" optional="show"/>
                <field name="warehouse_id"/>
                <field name="product_id"/>
                <field name="product_qty" sum="Total"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
                <field name="partner_id"/>
                <field name="central_free_qty" optional="show"/>
                <field name="shop_qty_available" optional="hide"/>
                <field name="note" optional="hide"/>
                <field name="state" widget="badge" optional="show"/>
                <field name="is_consolidated" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_store_demand_line_search" model="ir.ui.view">
        <field name="name">matriz.store.demand.line.search</field>
        <field name="model">matriz.store.demand.line</field>
        <field name="arch" type="xml">
            <search string="Demanda de tiendas">
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="warehouse_id"/>
                <field name="demand_id"/>
                <filter name="filter_pending" string="Pendiente de consolidar"
                        domain="[('state', '=', 'sent'), ('is_consolidated', '=', False)]"/>
                <filter name="filter_consolidated" string="Consolidada"
                        domain="[('is_consolidated', '=', True)]"/>
                <filter name="filter_no_partner" string="Sin proveedor"
                        domain="[('partner_id', '=', False)]"/>
                <group>
                    <filter name="group_partner" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_warehouse" string="Tienda" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_store_demand_line_pending" model="ir.actions.act_window">
        <field name="name">Demanda pendiente</field>
        <field name="res_model">matriz.store.demand.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_store_demand_line_search"/>
        <field name="context">{'search_default_filter_pending': 1, 'search_default_group_partner': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay demanda pendiente</p>
            <p>Aquí aparecen las líneas de los pre-pedidos enviados por las tiendas
               que todavía no se han consolidado en compras.</p>
        </field>
    </record>
</odoo>
