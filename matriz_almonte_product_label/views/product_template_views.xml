<odoo>

    <record id="product_template_form_view_label_button" model="ir.ui.view">
        <field name="name">product.template.form.matriz.almonte.label.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="%(matriz_almonte_product_label.action_matriz_almonte_product_label_wizard_tmpl)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-barcode"
                >
                    <span>Etiqueta QL-700</span>
                </button>
            </xpath>
        </field>
    </record>

</odoo>

