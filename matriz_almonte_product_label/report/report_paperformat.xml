<odoo>

    <record id="paperformat_brother_ql700" model="report.paperformat">
        <field name="name">Etiqueta Brother QL-700 (50 x 29 mm)</field>
        <field name="default" eval="False" />
        <field name="format">custom</field>
        <field name="page_height">29</field>
        <field name="page_width">50</field>
        <!-- OJO: wkhtmltopdf intercambia width/height cuando orientation=Landscape
             (lo usa para rotar tamaños estándar tipo A4). Como aquí ya definimos
             manualmente el ancho (50) mayor que el alto (29), hay que dejar
             'Portrait' para que NO se invietan y el resultado sea 50x29 real. -->
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True" />
        <!-- OJO: con dpi alto, wkhtmltopdf activa un zoom de compensación
             (ratio 96/dpi) que descuadra el posicionamiento absoluto en
             mm del contenido. Se deja el dpi estándar (96) que no
             requiere zoom de compensación; la resolución de impresión
             real la determina el driver de la Brother QL-700, no este
             valor. -->
        <field name="dpi">96</field>
    </record>

</odoo>

