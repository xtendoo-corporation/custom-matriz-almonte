<odoo>

    <record id="action_report_product_label_40x25" model="ir.actions.report">
        <field name="name">Etiquetas de producto 40 x 25 mm (Brother QL-700)</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">matriz_almonte_product_label.product_label_report_40x25</field>
        <field name="report_file">matriz_almonte_product_label.product_label_report_40x25</field>
        <field
            name="print_report_name"
            >'Etiquetas 40x25 - %s' % (object.display_name or '')</field>
        <field name="paperformat_id" ref="paperformat_brother_ql700_40x25" />
    </record>

    <template id="product_label_report_40x25">
        <html>
            <head />
            <body>
                <!-- Mismo contenido que la etiqueta estándar (nombre, precio,
                     código de barras y referencia) en 40 x 25 mm. Ver los
                     comentarios de product_label_report.xml para el detalle
                     de por qué el <style> y el <meta charset> van dentro de
                     <main>. -->
                <main>
                    <meta charset="utf-8" />
                    <style type="text/css">
                        @page {
                            size: 40mm 25mm;
                            margin: 0;
                        }
                        * {
                            box-sizing: border-box;
                        }
                        html, body {
                            margin: 0;
                            padding: 0;
                        }
                        .label {
                            position: relative;
                            width: 40mm;
                            height: 25mm;
                            overflow: hidden;
                            font-family: Arial, Helvetica, sans-serif;
                            color: #000000;
                        }
                        .label-name {
                            position: absolute;
                            top: 1mm;
                            left: 1.5mm;
                            right: 1.5mm;
                            font-size: 7.5pt;
                            font-weight: bold;
                            text-align: center;
                            white-space: nowrap;
                            overflow: hidden;
                            text-overflow: ellipsis;
                        }
                        .label-price {
                            position: absolute;
                            top: 5mm;
                            left: 1.5mm;
                            right: 1.5mm;
                            font-size: 13pt;
                            font-weight: bold;
                            text-align: center;
                            white-space: nowrap;
                            overflow: hidden;
                        }
                        .label-barcode {
                            position: absolute;
                            top: 11mm;
                            left: 0;
                            right: 0;
                            height: 8mm;
                            text-align: center;
                        }
                        .label-ref {
                            position: absolute;
                            top: 19.8mm;
                            left: 1.5mm;
                            right: 1.5mm;
                            font-size: 8pt;
                            font-weight: bold;
                            letter-spacing: 0.2mm;
                            text-align: center;
                            white-space: nowrap;
                            overflow: hidden;
                        }
                    </style>
                    <t t-foreach="labels" t-as="label">
                        <div
                            class="label"
                            t-attf-style="#{'' if label_first else 'page-break-before: always;'}"
                        >
                            <div class="label-name" t-esc="label['name']" />
                            <div class="label-price" t-out="label['price']" />
                            <div class="label-barcode" t-out="label['barcode_svg']" />
                            <div class="label-ref" t-esc="label['default_code']" />
                        </div>
                    </t>
                </main>
            </body>
        </html>
    </template>

</odoo>
