<odoo>

    <record id="action_report_product_label_brother_ql700" model="ir.actions.report">
        <field name="name">Etiquetas de producto (Brother QL-700)</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">matriz_almonte_product_label.product_label_report</field>
        <field name="report_file">matriz_almonte_product_label.product_label_report</field>
        <field
            name="print_report_name"
            >'Etiquetas - %s' % (object.display_name or '')</field>
        <field name="paperformat_id" ref="paperformat_brother_ql700" />
    </record>

    <template id="product_label_report">
        <html>
            <head />
            <body>
                <!-- Odoo 19 exige un elemento <main> en el HTML del reporte
                     (ir_actions_report._prepare_html busca //main); sin él
                     falla con IndexError: list index out of range.
                     ADEMÁS: _prepare_html, al no existir ningún div.article,
                     hace un fallback que solo conserva los HIJOS de <main>
                     (descarta el resto, incluido el <head>). Por eso el
                     <style> y el <meta charset> se definen AQUÍ DENTRO (y
                     no en <head>): si no, se pierden. Sin <style>, todo el
                     posicionamiento absoluto deja de aplicarse. Sin el
                     <meta charset="utf-8">, caracteres especiales como "€"
                     se muestran corruptos (por eso, además, el precio se
                     imprime con la entidad HTML numérica del euro, ver
                     ``_format_price`` en el parser Python). -->
                <main>
                    <meta charset="utf-8" />
                    <style type="text/css">
                        @page {
                            size: 50mm 29mm;
                            margin: 0;
                        }
                        * {
                            box-sizing: border-box;
                        }
                        html, body {
                            margin: 0;
                            padding: 0;
                        }
                        /* Posicionamiento absoluto (en lugar de flexbox) por
                           compatibilidad con el motor WebKit de wkhtmltopdf,
                           que gestiona mal flexbox combinado con saltos de
                           página en páginas de tamaño tan reducido
                           (50 x 29 mm). */
                        .label {
                            position: relative;
                            width: 50mm;
                            height: 29mm;
                            overflow: hidden;
                            font-family: Arial, Helvetica, sans-serif;
                            color: #000000;
                        }
                        /* 1. Nombre del producto: primera línea, arriba de
                           todo. "top" con un pequeño margen (en vez de
                           pegado al borde) porque la Brother QL-700 tiene
                           un margen automático de no-impresión al inicio
                           de cada etiqueta. */
                        .label-name {
                            position: absolute;
                            top: 2mm;
                            left: 1mm;
                            right: 1mm;
                            height: 6mm;
                            font-size: 8.5pt;
                            font-weight: bold;
                            line-height: 1.15;
                            text-align: left;
                            overflow: hidden;
                            display: -webkit-box;
                            -webkit-box-orient: vertical;
                            -webkit-line-clamp: 2;
                            text-overflow: ellipsis;
                        }
                        /* línea separadora sutil entre el nombre y el resto,
                           alineada al mismo margen izquierdo que el resto de
                           elementos (en vez de centrada). */
                        .label-divider {
                            position: absolute;
                            top: 8.3mm;
                            left: 1mm;
                            right: 1mm;
                            height: 0;
                            border-top: 0.4pt solid #444444;
                        }
                        /* 2. Precio de venta con IVA incluido */
                        .label-price {
                            position: absolute;
                            top: 8.6mm;
                            left: 1mm;
                            right: 1mm;
                            height: 5.5mm;
                            font-size: 14.5pt;
                            font-weight: bold;
                            text-align: left;
                            white-space: nowrap;
                            overflow: hidden;
                        }
                        /* 3. Código de barras */
                        .label-barcode {
                            position: absolute;
                            top: 14.4mm;
                            left: 2mm;
                            right: 2mm;
                            height: 9mm;
                            text-align: left;
                        }
                        .label-barcode img {
                            display: inline-block;
                        }
                        /* 4. Referencia del producto: debajo del código de barras */
                        .label-ref {
                            position: absolute;
                            top: 23.7mm;
                            left: 1mm;
                            right: 1mm;
                            height: 4.5mm;
                            font-size: 11pt;
                            font-weight: bold;
                            letter-spacing: 0.3mm;
                            text-align: left;
                            white-space: nowrap;
                            overflow: hidden;
                        }
                    </style>
                    <t t-foreach="labels" t-as="label">
                        <div
                            class="label"
                            t-attf-style="#{'' if label_first else 'page-break-before: always;'}"
                        >
                            <div class="label-name" t-esc="label['name']" />
                            <div class="label-divider" />
                            <div class="label-price" t-out="label['price']" />
                            <div class="label-barcode">
                                <img
                                    t-if="label['barcode_image']"
                                    t-att-src="label['barcode_image']['src']"
                                    t-att-width="label['barcode_image']['width']"
                                    t-att-height="label['barcode_image']['height']"
                                />
                            </div>
                            <div class="label-ref" t-esc="label['default_code']" />
                        </div>
                    </t>
                </main>
            </body>
        </html>
    </template>

</odoo>


