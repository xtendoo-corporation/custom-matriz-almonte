<odoo>

    <record id="action_report_product_label_brother_ql700" model="ir.actions.report">
        <field name="name">Etiquetas de producto (Brother QL-700)</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">matriz_almonte_product_label.product_label_report</field>
        <field name="report_file">matriz_almonte_product_label.product_label_report</field>
        <field
            name="print_report_name"
            >'Etiquetas - %s' % (object.display_name or '')</field>
        <field name="paperformat_id" ref="paperformat_brother_ql700" />
    </record>

    <template id="product_label_report">
        <html>
            <head>
                <style type="text/css">
                    @page {
                        size: 50mm 29mm;
                        margin: 0;
                    }
                    * {
                        box-sizing: border-box;
                    }
                    html, body {
                        margin: 0;
                        padding: 0;
                    }
                    /* Posicionamiento absoluto (en lugar de flexbox) por
                       compatibilidad con el motor WebKit de wkhtmltopdf, que
                       gestiona mal flexbox combinado con saltos de página en
                       páginas de tamaño tan reducido (50 x 29 mm). */
                    .label {
                        position: relative;
                        width: 50mm;
                        height: 29mm;
                        overflow: hidden;
                        font-family: Arial, Helvetica, sans-serif;
                        color: #000000;
                    }
                    .label-ref {
                        position: absolute;
                        top: 1mm;
                        left: 1.5mm;
                        max-width: 27mm;
                        font-size: 7pt;
                        font-weight: bold;
                        overflow: hidden;
                        white-space: nowrap;
                        text-overflow: ellipsis;
                    }
                    .label-price {
                        position: absolute;
                        top: 0.8mm;
                        right: 1.5mm;
                        font-size: 12pt;
                        font-weight: bold;
                        white-space: nowrap;
                    }
                    .label-name {
                        position: absolute;
                        top: 6.5mm;
                        left: 1.5mm;
                        right: 1.5mm;
                        height: 7.5mm;
                        font-size: 7pt;
                        line-height: 1.05;
                        overflow: hidden;
                        text-align: center;
                    }
                    .label-barcode {
                        position: absolute;
                        bottom: 1mm;
                        left: 1.5mm;
                        right: 1.5mm;
                        height: 10mm;
                        text-align: center;
                        line-height: 0;
                    }
                    .label-barcode img {
                        height: 10mm;
                        max-width: 100%;
                    }
                </style>
            </head>
            <body>
                <!-- Odoo 19 exige un elemento <main> en el HTML del reporte
                     (ir_actions_report._prepare_html busca //main); sin él
                     falla con IndexError: list index out of range. -->
                <main>
                    <t t-foreach="labels" t-as="label">
                        <div
                            class="label"
                            t-attf-style="#{'' if label_first else 'page-break-before: always;'}"
                        >
                            <span class="label-ref" t-esc="label['default_code']" />
                            <span class="label-price" t-esc="label['price']" />
                            <div class="label-name" t-esc="label['name']" />
                            <div class="label-barcode">
                                <img
                                    t-if="label['barcode_image']"
                                    t-att-src="label['barcode_image']"
                                />
                            </div>
                        </div>
                    </t>
                </main>
            </body>
        </html>
    </template>

</odoo>


