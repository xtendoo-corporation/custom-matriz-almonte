<odoo>

    <record id="action_report_product_label_brother_ql700" model="ir.actions.report">
        <field name="name">Etiquetas de producto (Brother QL-700)</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">matriz_almonte_product_label.product_label_report</field>
        <field name="report_file">matriz_almonte_product_label.product_label_report</field>
        <field
            name="print_report_name"
            >'Etiquetas - %s' % (object.display_name or '')</field>
        <field name="paperformat_id" ref="paperformat_brother_ql700" />
    </record>

    <template id="product_label_report">
        <html>
            <head>
                <style type="text/css">
                    @page {
                        size: 50mm 29mm;
                        margin: 0;
                    }
                    * {
                        box-sizing: border-box;
                    }
                    html, body {
                        margin: 0;
                        padding: 0;
                    }
                    .label {
                        width: 50mm;
                        height: 29mm;
                        padding: 1mm 1.5mm;
                        overflow: hidden;
                        font-family: Arial, Helvetica, sans-serif;
                        color: #000000;
                        page-break-after: always;
                        page-break-inside: avoid;
                        display: flex;
                        flex-direction: column;
                        justify-content: space-between;
                    }
                    .label-header {
                        display: flex;
                        flex-direction: row;
                        justify-content: space-between;
                        align-items: flex-start;
                        width: 100%;
                    }
                    .label-ref {
                        font-size: 7pt;
                        font-weight: bold;
                        max-width: 58%;
                        overflow: hidden;
                        white-space: nowrap;
                        text-overflow: ellipsis;
                    }
                    .label-price {
                        font-size: 12pt;
                        font-weight: bold;
                        white-space: nowrap;
                    }
                    .label-name {
                        font-size: 7pt;
                        line-height: 1.05;
                        max-height: 7.4mm;
                        overflow: hidden;
                        text-align: center;
                        width: 100%;
                    }
                    .label-barcode {
                        width: 100%;
                        text-align: center;
                        height: 9mm;
                        line-height: 0;
                    }
                    .label-barcode img {
                        height: 9mm;
                        max-width: 100%;
                    }
                </style>
            </head>
            <body>
                <t t-foreach="labels" t-as="label">
                    <div class="label">
                        <div class="label-header">
                            <span class="label-ref" t-esc="label['default_code']" />
                            <span class="label-price" t-esc="label['price']" />
                        </div>
                        <div class="label-name" t-esc="label['name']" />
                        <div class="label-barcode">
                            <img
                                t-if="label['barcode_image']"
                                t-att-src="label['barcode_image']"
                            />
                        </div>
                    </div>
                </t>
            </body>
        </html>
    </template>

</odoo>


