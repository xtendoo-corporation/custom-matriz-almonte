<odoo>

    <record id="matriz_almonte_product_label_wizard_form_view" model="ir.ui.view">
        <field name="name">matriz_almonte_product_label_wizard.form</field>
        <field name="model">matriz_almonte_product_label_wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimir etiquetas (Brother QL-700)">
                <group>
                    <field
                        name="product_ids"
                        widget="many2many_tags"
                        options="{'no_create': True}"
                    />
                    <field name="custom_quantity" />
                </group>
                <footer>
                    <button
                        name="action_print_report"
                        type="object"
                        string="Imprimir"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancelar"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_matriz_almonte_product_label_wizard" model="ir.actions.act_window">
        <field name="name">Imprimir etiquetas (Brother QL-700)</field>
        <field name="res_model">matriz_almonte_product_label_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_view_types">list,form</field>
        <field name="binding_model_id" ref="product.model_product_product" />
    </record>

    <record id="action_matriz_almonte_product_label_wizard_tmpl" model="ir.actions.act_window">
        <field name="name">Imprimir etiquetas (Brother QL-700)</field>
        <field name="res_model">matriz_almonte_product_label_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_view_types">list,form</field>
        <field name="binding_model_id" ref="product.model_product_template" />
    </record>

</odoo>

